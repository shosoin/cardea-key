diff --git a/src/piv/cmd_reset.c b/src/piv/cmd_reset.c
index fe9da9e..f7519d4 100644
--- a/src/piv/cmd_reset.c
+++ b/src/piv/cmd_reset.c
@@ -19,6 +19,78 @@
 #include "piv.h"
 
 
+#ifdef KEYV2_UNIFIED
+static bool piv_reset_owned_fid(uint16_t fid) {
+    return fid == EF_DEK_PWPIV || fid == EF_PIV_PIN || fid == EF_PIV_PUK || fid == EF_PIV_DISCOVERY ||
+           fid == EF_PIV_BITGT || (fid >= EF_PIV_ADMIN_DATA && fid <= EF_PIV_MSROOTS5) ||
+           (fid >= EF_PIV_CARD_AUTH && fid <= EF_PIV_PC_REF_DATA);
+}
+
+typedef struct piv_reset_context {
+    int value;
+} piv_reset_context_t;
+
+static bool piv_reset_dynamic(file_t *file, void *ctx) {
+    piv_reset_context_t *context = (piv_reset_context_t *)ctx;
+    if (!piv_reset_owned_fid(file->fid)) {
+        return true;
+    }
+    file_delete_result_t result = file_delete_no_commit_parts(file);
+    if (result.value != PICOKEYS_OK) {
+        context->value = result.value;
+        return false;
+    }
+    return true;
+}
+
+static int piv_reset_storage(void) {
+    /* Claves PIV (contenedores) y sus metadatos */
+    for (uint16_t key = 0; key <= 0xff; key++) {
+        if (openpgp_key_container_is_piv(key)) {
+            int r = openpgp_key_container_delete(key, true);
+            if (r != PICOKEYS_OK && r != PICOKEYS_ERR_FILE_NOT_FOUND) {
+                return r;
+            }
+            meta_delete_no_commit(key);
+        }
+    }
+    /* Ficheros PIV de la tabla estatica */
+    for (file_entry_t *entry = file_entries; entry != file_last; entry++) {
+        file_t *file = &entry->file;
+        if (file->fid != 0 && piv_reset_owned_fid(file->fid) && (file_get_type(file) & FILE_DATA_FLASH) && file_has_data(file)) {
+            file_delete_result_t result = file_delete_no_commit_parts(file);
+            if (result.value != PICOKEYS_OK) {
+                return result.value;
+            }
+        }
+    }
+    /* Ficheros PIV dinamicos */
+    piv_reset_context_t context = { .value = PICOKEYS_OK };
+    file_for_each_dynamic(piv_reset_dynamic, &context);
+    if (context.value != PICOKEYS_OK) {
+        return context.value;
+    }
+    /* Reintentos de PIN/PUK de PIV a 3 (bytes 7-8 de EF_PW_PRIV, 4-5 de EF_PW_RETRIES) */
+    file_t *ef = file_search_by_fid(EF_PW_RETRIES, NULL, SPECIFY_EF);
+    if (ef && file_get_size(ef) >= 6) {
+        uint8_t retries[16];
+        uint16_t len = (uint16_t)MIN(file_get_size(ef), sizeof(retries));
+        memcpy(retries, file_get_data(ef), len);
+        retries[4] = retries[5] = 3;
+        file_put_data(ef, CONST_BYTE_ARRAY(retries, len));
+    }
+    ef = file_search_by_fid(EF_PW_PRIV, NULL, SPECIFY_EF);
+    if (ef && file_get_size(ef) >= 9) {
+        uint8_t status[16];
+        uint16_t len = (uint16_t)MIN(file_get_size(ef), sizeof(status));
+        memcpy(status, file_get_data(ef), len);
+        status[7] = status[8] = 3;
+        file_put_data(ef, CONST_BYTE_ARRAY(status, len));
+    }
+    return PICOKEYS_OK;
+}
+#endif
+
 int cmd_reset(void) {
     if (P1(apdu) != 0x0 || P2(apdu) != 0x0) {
         return SW_INCORRECT_P1P2();
@@ -32,7 +104,15 @@ int cmd_reset(void) {
     if (retPIN != 0 || retPUK != 0) {
         return SW_INCORRECT_PARAMS();
     }
+#ifdef KEYV2_UNIFIED
+    /* key-v2: upstream hace file_initialize_flash(true), que vacia TODO el pool de datos
+       (credenciales FIDO, OATH, claves OpenPGP...). Aqui solo se borra lo de PIV. */
+    if (piv_reset_storage() != PICOKEYS_OK) {
+        return SW_EXEC_ERROR();
+    }
+#else
     file_initialize_flash(true);
+#endif
     flash_commit();
     init_piv();
     return SW_OK();

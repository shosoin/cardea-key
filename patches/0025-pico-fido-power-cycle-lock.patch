         if (mbedtls_mpi_read_binary(&hkey.ctx.mbed_ecdh.Qp.X, kax.data, kax.len) != 0) {
             CBOR_ERROR(CTAP1_ERR_INVALID_PARAMETER);
         }
diff --git a/src/fido/cbor_reset.c b/src/fido/cbor_reset.c
index 65bcd62..d90e1d4 100644
--- a/src/fido/cbor_reset.c
+++ b/src/fido/cbor_reset.c
@@ -132,6 +132,8 @@ static int fido_reset_storage(void) {
     return context.metadata_failed ? PICOKEYS_EXEC_ERROR : PICOKEYS_OK;
 }
 
+extern bool needs_power_cycle;
+
 int cbor_reset(void) {
 #ifndef ENABLE_EMULATION
 #if defined(ENABLE_POWER_ON_RESET) && ENABLE_POWER_ON_RESET == 1
@@ -150,6 +152,7 @@ int cbor_reset(void) {
     if (fido_reset_storage() != PICOKEYS_OK) {
         return CTAP2_ERR_PROCESSING;
     }
+    needs_power_cycle = false;   /* the PIN is gone; a reset needs the button anyway */
     init_fido();
 #ifdef DEFAULT_MCUV_NOT_REQUIRED
     set_opts(get_opts() | FIDO2_OPT_MCUV_NOTRQD);
diff --git a/src/fido/fido.c b/src/fido/fido.c

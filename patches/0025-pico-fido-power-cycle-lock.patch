diff --git a/src/fido/cbor_client_pin.c b/src/fido/cbor_client_pin.c
index 0351fa9..71e772a 100644
--- a/src/fido/cbor_client_pin.c
+++ b/src/fido/cbor_client_pin.c
@@ -802,6 +802,10 @@ int cbor_client_pin(const uint8_t *data, size_t len) {
         if ((*file_get_data(ef_pin) & PIN_RETRY_COUNT_MASK) == 0) {
             CBOR_ERROR(CTAP2_ERR_PIN_BLOCKED);
         }
+        if (needs_power_cycle) {
+            /* 3 mismatches since boot: no PIN is evaluated (nor an attempt spent) until a power cycle */

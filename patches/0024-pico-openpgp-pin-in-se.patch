+    }
+    if (r == PICOKEYS_OK && dek_fid) {
+        r = file_put_data(ef_dek, CONST_BYTE_ARRAY(wrapped, sizeof(wrapped)));
+    }
+    if (r == PICOKEYS_OK && dek_fid && pin_txn_layout(pin->fid)) {

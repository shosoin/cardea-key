+/* Mirror of the backend counter in EF_PW_PRIV, for the status DOs. */
+static void pin_mirror_retries(const file_t *pin, uint8_t retries) {
+    file_t *pw_status = file_search_by_fid(EF_PW_PRIV, NULL, SPECIFY_EF);
+    uint16_t i = 3u + (pin->fid & 0xfu);
+    if (!pw_status || !file_has_data(pw_status) || file_get_size(pw_status) > 64 || i >= file_get_size(pw_status) ||
+        file_get_data(pw_status)[i] == retries) {
+        return;
+    }
+    uint8_t status[64];
+    uint16_t status_len = file_get_size(pw_status);
+    memcpy(status, file_get_data(pw_status), status_len);
+    status[i] = retries;
+    file_put_data(pw_status, CONST_BYTE_ARRAY(status, status_len));
+    flash_commit();
+}

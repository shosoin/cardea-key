+    }
+    flash_commit();
+    mbedtls_platform_zeroize(plain, sizeof(plain));
+    mbedtls_platform_zeroize(session, sizeof(session));
+    mbedtls_platform_zeroize(wrapped, sizeof(wrapped));
+    return r;
+}

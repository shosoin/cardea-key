+static int pin_move_to_se(const file_t *pin, const uint8_t *value, size_t len) {
+    uint16_t dek_fid = pin_dek_fid(pin->fid);
+    file_t *ef_dek = dek_fid ? file_search_by_fid(dek_fid, NULL, SPECIFY_EF) : NULL;
+    uint8_t plain[DEK_SIZE], session[32], record[34], wrapped[DEK_FILE_SIZE];
+    int r = PICOKEYS_OK;
+    if (pin_se_slot(pin->fid) < 0) {
+        return PICOKEYS_OK;
+    }
+    if (dek_fid) {
+        if (!ef_dek || !file_has_data(ef_dek) || file_get_size(ef_dek) != DEK_FILE_SIZE || file_get_data(ef_dek)[0] != 0x3) {

+static volatile bool async_button_local = false;
+static volatile button_event_t local_button_result = BUTTON_EV_NONE;
+
+static void button_wait_begin(uint32_t timeout_seconds);
+
+void button_wait_start_local(uint32_t timeout_seconds) {
+    if (async_button_wait && !async_button_local) {
+        /* Cardea Key: el hilo de la tarjeta ya espera el boton; una espera local no se la quita. */
+        local_button_result = BUTTON_EV_CANCELLED;
+        return;
+    }
+    local_button_result = BUTTON_EV_NONE;
+    async_button_local = true;
+    bool previous_force = force_button_wait;
+    force_button_wait = true;
+    button_wait_begin(timeout_seconds);
+    force_button_wait = previous_force;
+}
+
+button_event_t button_local_result(void) {
+    button_event_t r = local_button_result;
+    if (r != BUTTON_EV_NONE) {
+        local_button_result = BUTTON_EV_NONE;
+    }
+    return r;
+}
+
 void button_wait_start_timeout(uint32_t timeout_seconds) {
+    if (async_button_wait && async_button_local) {
+        /* Cardea Key: el hilo de la tarjeta pide el boton mientras hay una espera local (toque OTP
+         * por el teclado HID). La local se cancela y la espera pasa al hilo de la tarjeta. Si no, el
+         * resultado iba a la espera local, el hilo de la tarjeta esperaba para siempre en su cola y
+         * acababa colgando tambien la tarea USB. */
+        async_button_local = false;
+        async_button_wait = false;
+        req_button_pending = false;
+        led_set_mode(async_button_led_mode);
+        local_button_result = BUTTON_EV_CANCELLED;
+    }
+    button_wait_begin(timeout_seconds);
+}
+
+static void button_wait_begin(uint32_t timeout_seconds) {
     uint32_t button_timeout = timeout_seconds * 1000;
     if (button_timeout == 0 && !force_button_wait) {
         signal_emit(SIGNAL_USER_PRESENCE_COMPLETED);
@@ -172,7 +214,13 @@ void button_wait_poll(void) {
     else if (result == BUTTON_EV_CANCELLED) {
         flag = EV_BUTTON_CANCELLED;
     }
-    queue_try_add(&usb_to_card_q, &flag);

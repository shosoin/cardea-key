 extern int (*button_pressed_cb)(uint8_t);
 
 extern bool is_req_button_pending(void);
+/* key-v2: espera asincrona del boton cuyo resultado no va al hilo de la tarjeta sino que se consulta
+   con button_local_result() (BUTTON_EV_NONE mientras se espera). Para rutas que corren en la tarea
+   USB y no pueden bloquear, p. ej. el challenge-response OTP con toque por el teclado HID. */
+extern void button_wait_start_local(uint32_t timeout_seconds);
+extern button_event_t button_local_result(void);
 
 #endif // BUTTON_H

+ * (cardea_se_pin_managed()), EF_PIN keeps its 35-byte layout (power-cycle flag, code points) with
+ * format PIN_FORMAT_SE and no verifier: the verifier, the retry counter and the secret that wraps
+ * the device key live in the backend. A v0.1.0 EF_PIN moves there on the first correct PIN. With
+ * the soft backend nothing changes.
+ */
+#define PIN_FORMAT_SE 2
+
+static bool pin_data_in_se(const uint8_t *pin_data, uint16_t pin_data_len) {
+    return pin_data_len == PIN_DATA_LEN && pin_data[2] == PIN_FORMAT_SE;
+}

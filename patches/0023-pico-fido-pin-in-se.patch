+
+/* Checks the PIN in the SE. 0 = right, and session_pin holds the slot secret. Otherwise a CTAP
+ * error, with the same per-boot rule as the flash path (3 mismatches ask for a power cycle). */
+static int pin_verify_se(const uint8_t pin_hash[16], uint8_t pin_data[PIN_DATA_LEN]) {
+    uint8_t secret[32], remaining = 0;
+    int r = cardea_se_pin_verify(CARDEA_SE_PIN_FIDO, pin_hash, 16, secret, &remaining);
+    if (r == CARDEA_SE_PIN_OK) {
+        memcpy(session_pin, secret, sizeof(secret));
+        mbedtls_platform_zeroize(secret, sizeof(secret));
+        return 0;
+    }
+    if (r == CARDEA_SE_PIN_BLOCKED) {
+        return CTAP2_ERR_PIN_BLOCKED;
+    }
+    if (r != CARDEA_SE_PIN_WRONG) {
+        return CTAP2_ERR_PROCESSING;
+    }
+    regenerate();
+    resetPinUvAuthToken();
+    if (remaining == 0) {
+        return CTAP2_ERR_PIN_BLOCKED;
+    }
+    bool power_cycle_locked = (pin_data[0] & PIN_RETRY_POWER_CYCLE) != 0;
+    if (power_cycle_locked || ++new_pin_mismatches >= 3) {
+        if (!power_cycle_locked) {
+            pin_data[0] |= PIN_RETRY_POWER_CYCLE;
+            if (!persist_pin_retry_counter(ef_pin, pin_data, PIN_DATA_LEN)) {
+                return CTAP2_ERR_PROCESSING;
+            }
+        }
+        needs_power_cycle = true;
+        return CTAP2_ERR_PIN_AUTH_BLOCKED;
+    }
+    return CTAP2_ERR_PIN_INVALID;
+}
+
+/*
+ * Moves a PIN checked the v0.1.0 way into the SE; session_pin holds the old session key. Order
+ * that survives a power cut at any point: the device key goes to format 1 (not PIN-wrapped, so
+ * valid whatever EF_PIN says) before EF_PIN changes, and is wrapped with the new secret after.
+ */
+static int pin_move_to_se(const uint8_t pin_hash[16], uint8_t codepoints) {
+    uint8_t secret[32], kd[32], pd[PIN_DATA_LEN];
+    if (load_keydev(kd) != PICOKEYS_OK) {
+        return CTAP2_ERR_PIN_INVALID;
+    }
+    if (cardea_se_pin_set(CARDEA_SE_PIN_FIDO, pin_hash, 16, MAX_PIN_RETRIES, secret) != CARDEA_SE_PIN_OK) {
+        mbedtls_platform_zeroize(kd, sizeof(kd));
+        return CTAP2_ERR_PROCESSING;
+    }
+    int ret = encrypt_keydev_f1(kd);
+    mbedtls_platform_zeroize(kd, sizeof(kd));
+    if (ret != PICOKEYS_OK) {
+        mbedtls_platform_zeroize(secret, sizeof(secret));
+        return CTAP2_ERR_PROCESSING;
+    }
+    pin_data_for_se(pd, codepoints);
+    file_put_data(ef_pin, CONST_BYTE_ARRAY(pd, sizeof(pd)));
+    flash_commit();
+    memcpy(session_pin, secret, sizeof(secret));
+    mbedtls_platform_zeroize(secret, sizeof(secret));
+    return check_keydev_encrypted(session_pin);
+}
+#endif

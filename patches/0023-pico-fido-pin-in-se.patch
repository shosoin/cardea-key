+/* EF_PIN when the PIN is in the SE: retries byte (only its power-cycle flag means something), code
+ * points, PIN_FORMAT_SE, and zeros where the verifier was. */
+static void pin_data_for_se(uint8_t pin_data[PIN_DATA_LEN], uint8_t codepoints) {
+    memset(pin_data, 0, PIN_DATA_LEN);
+    pin_data[0] = MAX_PIN_RETRIES;
+    pin_data[1] = codepoints;
+    pin_data[2] = PIN_FORMAT_SE;

+++ b/src/fido/cbor_reset.c
@@ -32,6 +32,14 @@
 static bool fido_reset_should_clear(uint16_t fid) {
     uint8_t prefix = (uint8_t)(fid >> 8);
 
+#ifdef KEYV2_UNIFIED
+    /* key-v2: ficheros del SDK compartidos (metadatos de claves de OpenPGP/PIV, config
+       del hardware, MKEK en flash): un reset de FIDO no los toca. */
+    if (fid == EF_META || fid == EF_PHY || fid == EF_MKEK) {
+        return false;
+    }
+#endif
+
     switch (fid) {
         case EF_KEY_DEV:
         case EF_KEY_DEV_ENC:
@@ -55,7 +63,13 @@ static bool fido_reset_should_clear(uint16_t fid) {
     }
 
     // FIDO vault, credential, and resident-object records use these dynamic FID prefixes.
+#ifdef KEYV2_UNIFIED
+    /* key-v2: el vault del SDK (0xC4-0xC9) es compartido con OpenPGP/PIV; lo de FIDO
+       se borra con fido_vault_clear() en fido_reset_storage(). */
+    return prefix == 0xcf || (prefix >= 0xd0 && prefix <= 0xdc) || (prefix >= 0xe0 && prefix <= 0xe3);
+#else
     return (prefix >= 0xc4 && prefix <= 0xc9) || prefix == 0xcf || (prefix >= 0xd0 && prefix <= 0xdc) || (prefix >= 0xe0 && prefix <= 0xe3);
+#endif
 }
 

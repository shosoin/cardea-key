diff --git a/src/otp/otp.c b/src/otp/otp.c
index d465192..dd3c946 100644
--- a/src/otp/otp.c
+++ b/src/otp/otp.c
@@ -18,6 +18,13 @@
 #include "otp.h"
 #include "otp_platform.h"
 #include <stdlib.h>
+#include <string.h>
+#include <stdio.h>
+#include "picokeys.h"
+#include "file.h"
+#include "flash.h"
+#include "random.h"
+#include "mbedtls/platform_util.h"
 
 const uint8_t *otp_key_1 = NULL;
 const uint8_t *otp_key_2 = NULL;
@@ -34,6 +41,40 @@ bool otp_is_secure_boot_locked(void) {
     return otp_platform_is_secure_boot_locked();
 }
 
+#ifndef ENABLE_EMULATION
+/*
+ * key-v2: si la plataforma no da MKEK (OTP vacia o HARDEN_HARDWARE=OFF), se usa una
+ * MKEK aleatoria de 32 B guardada en el fichero persistente EF_MKEK de la flash.
+ * NO es seguro frente a quien vuelque la flash: evita que kbase se derive solo del
+ * numero de serie (publico por USB) y deja un unico punto donde enchufar el SE.
+ * Los resets de las apps no la tocan; un borrado completo de la flash la regenera.
+ */
+static uint8_t mkek_flash[32];
+
+static void otp_mkek_from_flash(void) {
+    if (file_has_data(ef_mkek) && file_get_size(ef_mkek) == sizeof(mkek_flash)) {
+        memcpy(mkek_flash, file_get_data(ef_mkek), sizeof(mkek_flash));
+        otp_key_1 = mkek_flash;
+        printf("MKEK: loaded from flash\n");
+        return;
+    }
+    random_fill_buffer(BYTE_ARRAY(mkek_flash, sizeof(mkek_flash)));
+    if (file_put_data(ef_mkek, CONST_BYTE_ARRAY(mkek_flash, sizeof(mkek_flash))) != PICOKEYS_OK) {
+        printf("MKEK: could not store in flash, running without MKEK\n");
+        mbedtls_platform_zeroize(mkek_flash, sizeof(mkek_flash));
+        return;
+    }
+    flash_commit();
+    otp_key_1 = mkek_flash;
+    printf("MKEK: generated and stored in flash\n");
+}
+#endif
+
 void otp_init(void) {
     otp_platform_init(&otp_key_1, &otp_key_2);
+#ifndef ENABLE_EMULATION
+    if (otp_key_1 == NULL) {
+        otp_mkek_from_flash();
+    }
+#endif
 }

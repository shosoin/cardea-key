+/*
+ * key-v2: con varias apps, un AID registrado puede ser prefijo de otro (OTP
+ * A0000005272001 frente a PIV/YubiKey A000000527200101). Upstream comparaba por
+ * prefijo: el registro del segundo se descartaba en silencio y el SELECT iba a la
+ * primera que coincidiera. Ahora solo se descarta un AID identico y el SELECT elige
+ * la coincidencia mas larga.
+ */
+static bool app_aid_equal(const uint8_t *a, const uint8_t *b) {
+    return a[0] == b[0] && memcmp(a + 1, b + 1, a[0]) == 0;
+}
+
+static app_t *app_best_match(const_byte_array_t aid) {
+    app_t *best = NULL;
+    for (int a = 0; a < num_apps; a++) {
+        if (aid.len >= apps[a].aid[0] && !memcmp(apps[a].aid + 1, aid.data, apps[a].aid[0])) {
+            if (!best || apps[a].aid[0] > best->aid[0]) {
+                best = &apps[a];
+            }
+        }
+    }
+    return best;
+}

 bool check_user_presence_for_credential(bool require_button) {
+#ifdef FORCE_BUTTON_WAIT
+    /* key-v2: con FORCE_BUTTON_WAIT, una credencial que exige boton lo espera de verdad. Sin
+       esto, con el tiempo de boton por defecto (0) getAssertion devolvia UP=1 sin pulsacion. */

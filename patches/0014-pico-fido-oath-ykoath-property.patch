+/*
+ * key-v2: en YKOATH (y ykman) la propiedad de PUT va como TAG_PROPERTY seguido de UN byte, sin
+ * longitud ("78 02" = exigir toque). Upstream la leia como TLV, no la encontraba y la credencial se
+ * guardaba sin toque: el codigo salia sin pulsar el boton. Se normaliza a TLV ("78 01 02") solo si
+ * con esa lectura el resto de los datos se parsea limpio hasta el final.
+ */
+static bool oath_tlv_tail_ok(const uint8_t *d, size_t n) {
+    size_t i = 0;
+    while (i < n) {
+        if (i + 2 > n) {
+            return false;
+        }
+        size_t len = d[i + 1];
+        if (i + 2 + len > n) {
+            return false;
+        }
+        i += 2 + len;
+    }
+    return true;
+}
+
+static size_t oath_normalize_property(const uint8_t *in, size_t n, uint8_t *out, size_t out_size) {
+    size_t i = 0, o = 0;
+    bool changed = false;
+    while (i < n) {
+        if (in[i] == TAG_PROPERTY && i + 1 < n && oath_tlv_tail_ok(in + i + 2, n - i - 2)) {
+            if (o + 3 > out_size) {
+                return 0;
+            }
+            out[o++] = TAG_PROPERTY;
+            out[o++] = 1;
+            out[o++] = in[i + 1];
+            i += 2;
+            changed = true;
+            continue;
+        }
+        if (i + 2 > n) {
+            return 0;
+        }
+        size_t len = in[i + 1];
+        if (i + 2 + len > n || o + 2 + len > out_size) {
+            return 0;
+        }
+        memcpy(out + o, in + i, 2 + len);
+        o += 2 + len;
+        i += 2 + len;
+    }
+    return changed ? o : 0;
+}

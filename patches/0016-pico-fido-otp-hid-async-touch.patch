+static uint8_t otp_pending_frame[sizeof(otp_frame_rx)];
+static bool otp_touch_pending = false, otp_touch_pressed = false;
+
+/*
+ * Procesa una trama OTP completa (64 B de datos + comando en [64]) y deja la respuesta en el buffer
+ * de envio. Corre en la tarea USB (nucleo 0). key-v2: si el hilo de la tarjeta esta ocupado no se
+ * toca 'apdu' (devuelve -1); si no, se guarda y se restaura (upstream lo dejaba corrompido y la CCID
+ * se quedaba colgada). Con 'touch_confirmed' el toque ya se ha dado (modo asincrono).
+ */
+static int otp_run_frame(uint8_t *frame, bool touch_confirmed) {
+    if (is_busy()) {
+        return -1;
+    }
+    static uint8_t hdr[5];
+    struct apdu apdu_saved = apdu;
+    apdu.header = hdr;
+    apdu.data = frame;
+    apdu.nc = 64;
+    apdu.rdata = otp_frame_tx;
+    apdu.rlen = 0;
+    apdu.header[0] = 0;
+    apdu.header[1] = 0x01;
+    apdu.header[2] = frame[64];
+    apdu.header[3] = 0;
+    _is_otp = true;
+    otp_touch_confirmed = touch_confirmed;
+    int ret = otp_process_apdu();
+    otp_touch_confirmed = false;
+    if (ret == 0x9000 && res_APDU_size > 0) {
+        otp_send_frame(apdu.rdata, apdu.rlen);
+    }
+    _is_otp = false;
+    apdu = apdu_saved;
+    return ret;
+}
+
+static void otp_touch_clear(void) {
+    otp_touch_pending = otp_touch_pressed = false;
+    mbedtls_platform_zeroize(otp_pending_frame, sizeof(otp_pending_frame));
+}
